&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
nremap=10
nsubcycle=1,30*2
/

&OUTPUT_PARAMS
noutput=1
foutput=0
aout=9d-2
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='../../../ICs/cosmo_256/'
/

&AMR_PARAMS
levelmin=8
levelmax=12
ngridtot=60000000
nparttot=90000000
nexpand=1
/

&REFINE_PARAMS
m_refine=30*8.,
interpol_var=1
interpol_type=0
/

&POISSON_PARAMS
epsilon=1d-4

